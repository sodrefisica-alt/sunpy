        ax1.set_ylabel('Temperatura (K)', fontsize=14, fontweight='bold')
        ax1.set_title('TEMPERATURAS SOLARES CALCULADAS', fontsize=16, fontweight='bold', pad=20)
        ax1.grid(True, alpha=0.3, axis='y', linestyle='--')
        
        # Subplot 2: Comparação com valores de referência
        reference_temps = {
            'Nossos Resultados': [self.results['photosphere']['temperature'], 
                                 self.results['sunspot']['temperature']],
            'Literatura (Neckel & Labs 1984)': [5772, 4200],
            'Literatura (Solanki 2003)': [5780, 3800]
        }
        
        x = np.arange(len(categories))
        width = 0.25
        multiplier = 0
        
        for attribute, measurement in reference_temps.items():
            offset = width * multiplier
            rects = ax2.bar(x + offset, measurement, width, label=attribute)
            multiplier += 1
        
        ax2.set_ylabel('Temperatura (K)', fontsize=14, fontweight='bold')
        ax2.set_title('COMPARAÇÃO COM LITERATURA', fontsize=16, fontweight='bold', pad=20)
        ax2.set_xticks(x + width, categories)
        ax2.legend(loc='upper right', fontsize=10)
        ax2.grid(True, alpha=0.3, axis='y', linestyle='--')
        
        plt.tight_layout()
        plt.savefig('figura2_temperaturas_comparacao.png', dpi=300, bbox_inches='tight')
        
        plt.show()
        
        return fig1, fig2
    
