    def run_complete_analysis(self, observation_date=None):
        """
        Executa análise completa
        
        Parameters:
        -----------
        observation_date : datetime, optional
            Data de observação específica
        """
        
        print("🚀 INICIANDO ANÁLISE CIENTÍFICA DA TEMPERATURA SOLAR")
        print("=" * 70)
        print("Método: Lei de Wien com dados espectroscópicos do SDO/NASA")
        print("Referências: Neckel & Labs (1984), Woods et al. (2009)")
        print("=" * 70)
        
        # 1. Aquisição de dados
        files = self.download_professional_data(observation_date)
        
        # 2. Processamento espectral
        self.process_spectral_data(files)
        
        # 3. Cálculo de temperaturas
        results = self.calculate_temperatures()
        
        # 4. Visualizações
        self.create_publication_plots()
        
        # 5. Tabela LaTeX
        self.generate_latex_table()
        
        # 6. Relatório final
        self._print_final_report()
        
        return results
    
