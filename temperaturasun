                    label='Dados Observacionais', zorder=5)
        
        # Curva de corpo negro ajustada
        wavelengths_fine = np.linspace(1000, 7000, 500)
        T_photo = self.results['photosphere']['methods']['blackbody_fit']
        
        def planck_curve(wavelength, T):
            wavelength_m = wavelength * 1e-10
            exponent = self.PLANCK_CONSTANT * self.SPEED_OF_LIGHT / (wavelength_m * 1.380649e-23 * T)
            intensity = (2 * self.PLANCK_CONSTANT * self.SPEED_OF_LIGHT**2 / 
                        (wavelength_m**5 * (np.exp(exponent) - 1)))
            return intensity / np.max(planck_curve(wavelengths_fine, T_photo))
        
        ax1.plot(wavelengths_fine, planck_curve(wavelengths_fine, T_photo), 
                '--', color='#FF6B35', linewidth=2.5, 
                label=f'Corpo Negro Ajustado (T = {T_photo:.0f} K)')
        
        ax1.axvline(self.results['photosphere']['lambda_max'], 
                   color='red', linestyle=':', linewidth=2,
