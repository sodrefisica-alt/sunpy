                    yerr=self.uncertainty, fmt='s', color='#8B4513', 
                    markersize=8, capsize=5, capthick=2, elinewidth=2,
                    label='Dados Observacionais', zorder=5)
        
        T_spot = self.results['sunspot']['methods']['blackbody_fit']
        ax2.plot(wavelengths_fine, planck_curve(wavelengths_fine, T_spot), 
                '--', color='#A0522D', linewidth=2.5,
                label=f'Corpo Negro Ajustado (T = {T_spot:.0f} K)')
        
        ax2.axvline(self.results['sunspot']['lambda_max'], 
                   color='red', linestyle=':', linewidth=2,
                   label=f'$λ_{{max}}$ = {self.results["sunspot"]["lambda_max"]:.1f} Å')
        
        ax2.set_xlabel('Comprimento de Onda (Å)', fontsize=14, fontweight='bold')
        ax2.set_ylabel('Intensidade Relativa', fontsize=14, fontweight='bold')
        ax2.set_title('ESPECTRO DE MANCHAS SOLARES', fontsize=16, fontweight='bold', pad=20)
        ax2.legend(fontsize=12, framealpha=0.9)
        ax2.grid(True, alpha=0.3, linestyle='--')
        ax2.set_xlim(1000, 7000)
        
        plt.tight_layout()
        plt.savefig('figura1_espectros_solares.png', dpi=300, bbox_inches='tight')
        
        # Figura 2: Comparação de temperaturas
        fig2, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
        
        # Subplot 1: Temperaturas calculadas
        categories = ['Fotosfera', 'Manchas Solares']
        temperatures = [self.results['photosphere']['temperature'], 
