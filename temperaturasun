        colors = ['#D4AF37', '#8B4513']
        
        bars = ax1.bar(categories, temperatures, yerr=uncertainties, 
                      capsize=10, color=colors, alpha=0.8, 
                      edgecolor='black', linewidth=1.5)
        
        # Adicionar valores nas barras
        for i, (bar, temp, unc) in enumerate(zip(bars, temperatures, uncertainties)):
            height = bar.get_height()
            ax1.text(bar.get_x() + bar.get_width()/2., height + 200,
                    f'{temp:.0f} ± {unc:.0f} K', ha='center', va='bottom', 
